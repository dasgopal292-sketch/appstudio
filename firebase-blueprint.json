{
  "entities": {
    "StudioService": {
      "title": "StudioService",
      "description": "A photography, framing, passport, or printing service offered by Studio Pixy with editable pricing.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Service title in English" },
        "hindiName": { "type": "string", "description": "Simple Hindi-friendly subtitle" },
        "category": {
          "type": "string",
          "enum": ["PHOTO_FRAMES", "PASSPORT_PHOTOGRAPHY", "PHOTOGRAPHY_SERVICES", "PHOTO_PRINTING"],
          "description": "Service category identifier"
        },
        "priceInr": { "type": "integer", "description": "Service price in Indian Rupees (INR)" },
        "unitLabel": { "type": "string", "description": "Pricing unit label such as Per Frame, Set of 8, Per Day" },
        "description": { "type": "string", "description": "Service details and inclusions" },
        "imageUrl": { "type": "string", "description": "Optional HTTPS image URL or picked media URI" },
        "presetKey": { "type": "string", "description": "Optional bundled drawable key (frames, passport, wedding, portrait)" },
        "available": { "type": "boolean", "description": "Whether service is currently active for customers" },
        "featured": { "type": "boolean", "description": "Whether service is highlighted on the Home screen" },
        "sortOrder": { "type": "integer", "description": "Display ordering index" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp on creation" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp on update" }
      },
      "required": ["name", "hindiName", "category", "priceInr", "unitLabel", "description", "available", "sortOrder", "createdAt", "updatedAt"]
    },
    "StudioConfig": {
      "title": "StudioConfig",
      "description": "Studio Pixy business contact details, WhatsApp number, opening hours, and special offer banner.",
      "type": "object",
      "properties": {
        "businessName": { "type": "string" },
        "tagline": { "type": "string" },
        "whatsappNumber": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "address": { "type": "string" },
        "email": { "type": "string" },
        "openingHours": { "type": "string" },
        "mapsQuery": { "type": "string" },
        "specialOfferTitle": { "type": "string" },
        "specialOfferDetails": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["businessName", "tagline", "whatsappNumber", "phoneNumber", "address", "email", "openingHours", "mapsQuery", "specialOfferTitle", "specialOfferDetails", "updatedAt"]
    },
    "CustomerOrder": {
      "title": "CustomerOrder",
      "description": "Customer order submitted through Studio Pixy and dispatched via WhatsApp.",
      "type": "object",
      "properties": {
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "requirements": { "type": "string" },
        "itemsSummary": { "type": "string" },
        "itemCount": { "type": "integer" },
        "totalInr": { "type": "integer" },
        "status": { "type": "string", "enum": ["PENDING", "CONFIRMED", "COMPLETED"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerName", "customerPhone", "itemsSummary", "itemCount", "totalInr", "status", "createdAt", "updatedAt"]
    },
    "SpecialOffer": {
      "title": "SpecialOffer",
      "description": "Seasonal discount or combo offer promoted by Studio Pixy.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "badge": { "type": "string" },
        "description": { "type": "string" },
        "promoCode": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "badge", "description", "promoCode", "active", "createdAt", "updatedAt"]
    },
    "CustomerReview": {
      "title": "CustomerReview",
      "description": "Public studio customer review and rating.",
      "type": "object",
      "properties": {
        "authorName": { "type": "string" },
        "rating": { "type": "integer" },
        "comment": { "type": "string" },
        "serviceTag": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorName", "rating", "comment", "serviceTag", "createdAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Authorized Studio Pixy admin UID marker.",
      "type": "object",
      "properties": {
        "email": { "type": "string" }
      },
      "required": ["email"]
    }
  },
  "firestore": {
    "/services/{serviceId}": {
      "schema": { "$ref": "#/entities/StudioService" },
      "description": "Editable Studio Pixy services and rate list across all categories."
    },
    "/studio_config/{configId}": {
      "schema": { "$ref": "#/entities/StudioConfig" },
      "description": "Editable studio contact details, WhatsApp number, and opening hours."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/CustomerOrder" },
      "description": "Customer orders viewable and manageable exclusively by authenticated admins."
    },
    "/offers/{offerId}": {
      "schema": { "$ref": "#/entities/SpecialOffer" },
      "description": "Special offers and discounts shown on the customer storefront."
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/CustomerReview" },
      "description": "Customer reviews for Studio Pixy."
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Admin authorization records."
    }
  }
}
