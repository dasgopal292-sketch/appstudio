rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email_verified == true && request.auth.token.email == 'dasgopal292@gmail.com') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidService(data) {
      return data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
             data.hindiName is string && data.hindiName.size() >= 1 && data.hindiName.size() <= 120 &&
             data.category in ['PHOTO_FRAMES', 'PASSPORT_PHOTOGRAPHY', 'PHOTOGRAPHY_SERVICES', 'PHOTO_PRINTING'] &&
             data.priceInr is int && data.priceInr >= 0 && data.priceInr <= 10000000 &&
             data.unitLabel is string && data.unitLabel.size() >= 1 && data.unitLabel.size() <= 50 &&
             data.description is string && data.description.size() >= 2 && data.description.size() <= 500 &&
             (!('imageUrl' in data) || data.imageUrl == null || (data.imageUrl is string && data.imageUrl.size() <= 600)) &&
             (!('presetKey' in data) || data.presetKey == null || (data.presetKey is string && data.presetKey.size() <= 50)) &&
             data.available is bool &&
             (!('featured' in data) || data.featured is bool) &&
             data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 10000;
    }

    function isValidStudioConfig(data) {
      return data.businessName is string && data.businessName.size() >= 2 && data.businessName.size() <= 80 &&
             data.tagline is string && data.tagline.size() >= 2 && data.tagline.size() <= 140 &&
             data.whatsappNumber is string && data.whatsappNumber.size() >= 8 && data.whatsappNumber.size() <= 20 &&
             data.phoneNumber is string && data.phoneNumber.size() >= 8 && data.phoneNumber.size() <= 20 &&
             data.address is string && data.address.size() >= 4 && data.address.size() <= 240 &&
             data.email is string && data.email.size() >= 5 && data.email.size() <= 120 &&
             data.openingHours is string && data.openingHours.size() >= 4 && data.openingHours.size() <= 140 &&
             data.mapsQuery is string && data.mapsQuery.size() >= 2 && data.mapsQuery.size() <= 240 &&
             data.specialOfferTitle is string && data.specialOfferTitle.size() >= 2 && data.specialOfferTitle.size() <= 100 &&
             data.specialOfferDetails is string && data.specialOfferDetails.size() >= 2 && data.specialOfferDetails.size() <= 240;
    }

    function isValidOrder(data) {
      return data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 80 &&
             data.customerPhone is string && data.customerPhone.size() >= 7 && data.customerPhone.size() <= 20 &&
             (!('requirements' in data) || data.requirements == null || (data.requirements is string && data.requirements.size() <= 600)) &&
             data.itemsSummary is string && data.itemsSummary.size() >= 2 && data.itemsSummary.size() <= 1200 &&
             data.itemCount is int && data.itemCount >= 1 && data.itemCount <= 500 &&
             data.totalInr is int && data.totalInr >= 0 && data.totalInr <= 10000000 &&
             data.status in ['PENDING', 'CONFIRMED', 'COMPLETED'];
    }

    function isValidOffer(data) {
      return data.title is string && data.title.size() >= 2 && data.title.size() <= 100 &&
             data.badge is string && data.badge.size() >= 1 && data.badge.size() <= 40 &&
             data.description is string && data.description.size() >= 2 && data.description.size() <= 300 &&
             data.promoCode is string && data.promoCode.size() >= 1 && data.promoCode.size() <= 30 &&
             data.active is bool;
    }

    function isValidReview(data) {
      return data.authorName is string && data.authorName.size() >= 2 && data.authorName.size() <= 60 &&
             data.rating is int && data.rating >= 1 && data.rating <= 5 &&
             data.comment is string && data.comment.size() >= 3 && data.comment.size() <= 400 &&
             data.serviceTag is string && data.serviceTag.size() >= 2 && data.serviceTag.size() <= 60;
    }

    // 1. Public Storefront Services (Admin write only)
    match /services/{serviceId} {
      allow get, list: if true;

      allow create: if isAdmin() &&
                       isValidId(serviceId) &&
                       incoming().keys().hasAll(['name', 'hindiName', 'category', 'priceInr', 'unitLabel', 'description', 'available', 'sortOrder', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['name', 'hindiName', 'category', 'priceInr', 'unitLabel', 'description', 'imageUrl', 'presetKey', 'available', 'featured', 'sortOrder', 'createdAt', 'updatedAt']) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidService(incoming());

      allow update: if isAdmin() &&
                       isValidId(serviceId) &&
                       isValidService(incoming()) &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['name', 'hindiName', 'category', 'priceInr', 'unitLabel', 'description', 'imageUrl', 'presetKey', 'available', 'featured', 'sortOrder', 'updatedAt']);

      allow delete: if isAdmin() && isValidId(serviceId);
    }

    // 2. Public Studio Business Config (Admin write only)
    match /studio_config/{configId} {
      allow get, list: if true;

      allow create: if isAdmin() &&
                       isValidId(configId) &&
                       incoming().keys().hasAll(['businessName', 'tagline', 'whatsappNumber', 'phoneNumber', 'address', 'email', 'openingHours', 'mapsQuery', 'specialOfferTitle', 'specialOfferDetails', 'updatedAt']) &&
                       incoming().keys().hasOnly(['businessName', 'tagline', 'whatsappNumber', 'phoneNumber', 'address', 'email', 'openingHours', 'mapsQuery', 'specialOfferTitle', 'specialOfferDetails', 'updatedAt']) &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidStudioConfig(incoming());

      allow update: if isAdmin() &&
                       isValidId(configId) &&
                       isValidStudioConfig(incoming()) &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['businessName', 'tagline', 'whatsappNumber', 'phoneNumber', 'address', 'email', 'openingHours', 'mapsQuery', 'specialOfferTitle', 'specialOfferDetails', 'updatedAt']);

      allow delete: if false;
    }

    // 3. Customer Orders (Customer creates PENDING order without login; ONLY Admin reads/updates/deletes)
    match /orders/{orderId} {
      allow get, list: if isAdmin();

      allow create: if isValidId(orderId) &&
                       incoming().keys().hasAll(['customerName', 'customerPhone', 'itemsSummary', 'itemCount', 'totalInr', 'status', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['customerName', 'customerPhone', 'requirements', 'itemsSummary', 'itemCount', 'totalInr', 'status', 'createdAt', 'updatedAt']) &&
                       incoming().status == 'PENDING' &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidOrder(incoming());

      allow update: if isAdmin() &&
                       isValidId(orderId) &&
                       isValidOrder(incoming()) &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);

      allow delete: if isAdmin() && isValidId(orderId);
    }

    // 4. Special Offers (Public read; Admin write)
    match /offers/{offerId} {
      allow get, list: if true;

      allow create: if isAdmin() &&
                       isValidId(offerId) &&
                       incoming().keys().hasAll(['title', 'badge', 'description', 'promoCode', 'active', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['title', 'badge', 'description', 'promoCode', 'active', 'createdAt', 'updatedAt']) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidOffer(incoming());

      allow update: if isAdmin() &&
                       isValidId(offerId) &&
                       isValidOffer(incoming()) &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['title', 'badge', 'description', 'promoCode', 'active', 'updatedAt']);

      allow delete: if isAdmin() && isValidId(offerId);
    }

    // 5. Customer Reviews (Public read & verified-schema create; Admin update/delete)
    match /reviews/{reviewId} {
      allow get, list: if true;

      allow create: if isValidId(reviewId) &&
                       incoming().keys().hasAll(['authorName', 'rating', 'comment', 'serviceTag', 'createdAt']) &&
                       incoming().keys().hasOnly(['authorName', 'rating', 'comment', 'serviceTag', 'createdAt']) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       isValidReview(incoming());

      allow update, delete: if isAdmin() && isValidId(reviewId);
    }

    // 6. Admin Authorization Records
    match /admins/{adminUid} {
      allow get: if isSignedIn() && request.auth.uid == adminUid;
      allow list, create, update, delete: if false;
    }
  }
}
